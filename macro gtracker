.sr-chip.car { background: rgba(245,166,35,0.1); color: var(--orange); }
.sr-chip.fat { background: rgba(155,124,255,0.1); color: var(--purple); }
.sr-chip.per { background: var(--bg); color: var(--text3); }

/* SERVING BOX */
.serving-box { background: var(--bg3); border: 1px solid var(--border); border-radius: var(--rsm); padding: 14px; margin-top: 12px; }
.sb-name { font-size: 14px; font-weight: 600; color: var(--text); margin-bottom: 10px; }
.sb-row { display: flex; gap: 8px; margin-bottom: 12px; }
.sb-amt { width: 90px; background: var(--bg2); border: 1px solid var(--border); border-radius: var(--rsm); padding: 10px 12px; color: var(--text); font-family: var(--font); font-size: 16px; font-weight: 700; text-align: center; outline: none; transition: border-color 0.15s; }
.sb-amt:focus { border-color: var(--accent); }
.sb-unit { flex: 1; background: var(--bg2); border: 1px solid var(--border); border-radius: var(--rsm); padding: 10px 12px; color: var(--text); font-family: var(--font); font-size: 13px; outline: none; cursor: pointer; }
.sb-preview { display: grid; grid-template-columns: repeat(4,1fr); gap: 8px; }
.sbp { text-align: center; background: var(--bg2); border-radius: var(--rxs); padding: 8px 4px; }
.sbp-val { font-size: 14px; font-weight: 700; }
.sbp-lbl { font-size: 9px; color: var(--text3); text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px; }

/* SCAN */
.scan-zone { border: 2px dashed var(--border2); border-radius: var(--r); padding: 32px 20px; text-align: center; cursor: pointer; transition: all 0.18s; position: relative; overflow: hidden; background: var(--bg3); }
.scan-zone:hover { border-color: var(--accent); background: var(--accent-dim); }
.scan-zone input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
.scan-zone-icon { font-size: 40px; margin-bottom: 10px; }
.scan-zone-title { font-size: 15px; font-weight: 700; color: var(--text); margin-bottom: 4px; }
.scan-zone-sub { font-size: 12px; color: var(--text3); }

.scan-preview-img { width: 100%; max-height: 200px; object-fit: cover; border-radius: var(--rsm); display: block; }

.scan-result-card { background: var(--bg3); border-radius: var(--rsm); border: 1px solid var(--border); padding: 14px; margin-top: 12px; }
.src-title { font-size: 14px; font-weight: 700; color: var(--text); margin-bottom: 10px; display: flex; align-items: center; gap: 6px; }
.src-macros { display: grid; grid-template-columns: repeat(4,1fr); gap: 8px; margin-bottom: 10px; }
.srcm { text-align: center; background: var(--bg2); border-radius: var(--rxs); padding: 8px 4px; }
.srcm-val { font-size: 15px; font-weight: 700; }
.srcm-lbl { font-size: 9px; color: var(--text3); text-transform: uppercase; margin-top: 2px; }
.src-confidence { display: flex; align-items: center; gap: 8px; font-size: 11px; color: var(--text3); margin-bottom: 8px; }
.conf-track { flex: 1; height: 3px; background: var(--border); border-radius: 2px; }
.conf-fill { height: 100%; border-radius: 2px; background: var(--green); }
.src-foods { }
.src-food-row { display: flex; justify-content: space-between; font-size: 12px; color: var(--text2); padding: 5px 0; border-bottom: 1px solid var(--border); }
.src-food-row:last-child { border-bottom: none; }
.src-note { font-size: 11px; color: var(--orange); margin-top: 8px; padding: 8px; background: var(--orange-dim); border-radius: var(--rxs); border-left: 2px solid var(--orange); }

/* CHAT */
.chat-msgs { height: 300px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; padding-bottom: 4px; margin-bottom: 12px; }
.chat-msgs::-webkit-scrollbar { width: 0; }
.cm { display: flex; gap: 8px; align-items: flex-start; }
.cm.user { flex-direction: row-reverse; }
.cm-av { width: 28px; height: 28px; border-radius: 50%; background: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0; margin-top: 2px; }
.cm-av.u { background: var(--card2); border: 1px solid var(--border); }
.cm-bubble { max-width: 80%; padding: 10px 13px; border-radius: 16px; font-size: 13px; line-height: 1.5; }
.cm.ai .cm-bubble { background: var(--card2); border: 1px solid var(--border); color: var(--text); border-top-left-radius: 4px; }
.cm.user .cm-bubble { background: var(--accent); color: #fff; border-top-right-radius: 4px; }
.typing-row { display: flex; gap: 4px; padding: 10px 13px; background: var(--card2); border: 1px solid var(--border); border-radius: 16px; border-top-left-radius: 4px; width: fit-content; }
.tdot { width: 6px; height: 6px; border-radius: 50%; background: var(--text3); animation: tb 1.1s infinite; }
.tdot:nth-child(2){animation-delay:.18s} .tdot:nth-child(3){animation-delay:.36s}
@keyframes tb{0%,60%,100%{transform:translateY(0)}30%{transform:translateY(-5px)}}
.chat-input-row { display: flex; gap: 8px; }
.chat-input-row .fi { flex: 1; }
.chat-send-btn { background: var(--accent); border: none; border-radius: var(--rsm); padding: 12px 16px; color: #fff; font-size: 16px; cursor: pointer; transition: all 0.15s; flex-shrink: 0; }
.chat-send-btn:hover { opacity: 0.9; }
.chat-send-btn:disabled { opacity: 0.4; cursor: not-allowed; }

/* CHECKIN MODAL */
.checkin-step { }
.checkin-q { font-size: 16px; font-weight: 700; color: var(--text); margin-bottom: 6px; line-height: 1.4; }
.checkin-sub { font-size: 13px; color: var(--text3); margin-bottom: 18px; }
.choice-row { display: flex; flex-direction: column; gap: 8px; }
.choice-btn { padding: 14px 16px; background: var(--bg3); border: 1px solid var(--border); border-radius: var(--rsm); color: var(--text); font-family: var(--font); font-size: 14px; font-weight: 500; cursor: pointer; text-align: left; transition: all 0.15s; display: flex; align-items: center; gap: 10px; }
.choice-btn:hover { border-color: var(--accent); background: var(--accent-dim); }
.choice-btn.selected { border-color: var(--accent); background: var(--accent-dim); color: var(--accent); }
.choice-emoji { font-size: 18px; }
.ai-result { background: var(--bg3); border-radius: var(--rsm); border: 1px solid var(--border); padding: 14px; margin-top: 4px; }
.air-title { font-size: 12px; font-weight: 700; color: var(--green); text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 8px; display: flex; align-items: center; gap: 6px; }
.air-body { font-size: 13px; color: var(--text2); line-height: 1.6; }
