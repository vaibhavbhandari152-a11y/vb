function handleScanFile(file) {
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    const b64 = e.target.result;
    document.getElementById('scan-img').src = b64;
    document.getElementById('scan-upload').style.display = 'none';
    document.getElementById('scan-result-area').style.display = '';
    document.getElementById('scan-loading').style.display = '';
    document.getElementById('scan-result-content').innerHTML = '';
    analyzeMeal(b64.split(',')[1], file.type || 'image/jpeg');
  };
  reader.readAsDataURL(file);
}

async function analyzeMeal(b64, mediaType) {
  try {
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        messages: [{
          role: 'user',
          content: [
            { type: 'image', source: { type: 'base64', media_type: mediaType, data: b64 } },
            { type: 'text', text: `Analyze this meal photo. Return ONLY valid JSON:
{"meal_name":"Name","confidence":80,"foods":[{"name":"food","portion":"150g","cal":200,"pro":20,"car":15,"fat":8}],"total":{"cal":400,"pro":35,"car":30,"fat":15},"notes":"any caveats"}` }
          ]
        }]
      })
    });
    const data = await res.json();
    const text = data.content?.[0]?.text || '';
    scannedData = JSON.parse(text.replace(/```json|```/g,'').trim());
    document.getElementById('scan-loading').style.display = 'none';
    const d = scannedData;
    document.getElementById('scan-result-content').innerHTML = `
      <div class="scan-result-card">
        <div class="src-title">🍽️ ${d.meal_name} <span style="font-size:10px;color:var(--text3);font-weight:400">(AI estimate)</span></div>
        <div class="src-macros">
          <div class="srcm"><div class="srcm-val" style="color:var(--accent)">${d.total.cal}</div><div class="srcm-lbl">kcal</div></div>
          <div class="srcm"><div class="srcm-val" style="color:var(--green)">${d.total.pro}g</div><div class="srcm-lbl">protein</div></div>
          <div class="srcm"><div class="srcm-val" style="color:var(--orange)">${d.total.car}g</div><div class="srcm-lbl">carbs</div></div>
          <div class="srcm"><div class="srcm-val" style="color:var(--purple)">${d.total.fat}g</div><div class="srcm-lbl">fat</div></div>
        </div>
        <div class="src-confidence"><span>Confidence</span><div class="conf-track"><div class="conf-fill" style="width:${d.confidence}%"></div></div><span>${d.confidence}%</span></div>
        <div class="src-foods">${(d.foods||[]).map(f=>`<div class="src-food-row"><span>${f.name} · ${f.portion}</span><span>${f.cal} cal</span></div>`).join('')}</div>
        ${d.notes ? `<div class="src-note">⚠ ${d.notes}</div>` : ''}
      </div>`;
    document.getElementById('scan-add-btn').style.display = '';
  } catch(e) {
    document.getElementById('scan-loading').innerHTML = '<span style="color:var(--red)">⚠ Analysis failed. Try a clearer photo.</span>';
  }
}

function addScanned() {
