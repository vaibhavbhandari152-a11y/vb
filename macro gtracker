function openCoach() {
  document.getElementById('coach-modal').classList.add('open');
  const c = document.getElementById('chat-msgs');
  if (!c.children.length) {
    if (chatHistory.length) chatHistory.forEach(m => appendMsg(m.r, m.t, false));
    else appendMsg('ai', "Hey! I'm your AI diet coach 💪 I can see your diary and goals. Ask me anything about your nutrition, what to eat, how to hit your macros, or get a weekly plan adjustment.", false);
  }
  setTimeout(() => document.getElementById('chat-in').focus(), 200);
}

function appendMsg(role, text, scroll=true) {
  const c = document.getElementById('chat-msgs');
  const div = document.createElement('div');
  div.className = 'cm ' + role;
  div.innerHTML = `<div class="cm-av ${role==='user'?'u':''}">${role==='ai'?'🤖':'👤'}</div><div class="cm-bubble">${text}</div>`;
  c.appendChild(div);
  if (scroll) c.scrollTop = c.scrollHeight;
}

async function sendChat() {
  const input = document.getElementById('chat-in');
  const msg = input.value.trim();
  if (!msg) return;
  appendMsg('user', msg);
  chatHistory.push({ r: 'user', t: msg });
  input.value = '';
  document.getElementById('chat-btn').disabled = true;

  const c = document.getElementById('chat-msgs');
  const typing = document.createElement('div');
  typing.className = 'cm ai'; typing.id = 'typing';
  typing.innerHTML = '<div class="cm-av">🤖</div><div class="typing-row"><div class="tdot"></div><div class="tdot"></div><div class="tdot"></div></div>';
  c.appendChild(typing); c.scrollTop = c.scrollHeight;

  try {
    const t = getTotals();
    const history = chatHistory.slice(-10).map(m => ({ role: m.r==='ai'?'assistant':'user', content: m.t }));
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        system: `You are a concise, science-based diet coach (like Carbon Diet Coach). Max 100 words per reply. User data: ${t.cal}/${S.goals.cal}kcal, protein ${t.pro}/${S.goals.pro}g, carbs ${t.car}/${S.goals.car}g, fat ${t.fat}/${S.goals.fat}g. Goal: ${S.goalType}. Diet: ${S.dietPref}. Week ${S.weekNum}. Meals: ${JSON.stringify(S.meals)}.`,
        messages: history
      })
    });
    const data = await res.json();
    const reply = data.content?.[0]?.text || 'Try again.';
    typing.remove();
    appendMsg('ai', reply);
    chatHistory.push({ r: 'ai', t: reply });
  } catch(e) {
    typing.remove();
    appendMsg('ai', 'Connection issue. Try again.');
  }
  document.getElementById('chat-btn').disabled = false;
}

function updateCoachBanner() {
  const t = getTotals(), g = S.goals;
  let msg = '';
  if (t.cal === 0) msg = 'Log your first meal to get personalized coaching.';
  else if (t.pro < g.pro * 0.5 && t.cal > g.cal * 0.4) msg = `Protein is low (${t.pro}g/${g.pro}g). Your next meal should be protein-focused.`;
  else if (t.cal > g.cal) msg = `You're ${t.cal - g.cal} calories over today. Consider lighter options for remaining meals.`;
  else if (t.cal > g.cal * 0.85) msg = `Great work! Almost at your goal — ${g.cal - t.cal} calories remaining.`;
  else msg = `${Math.round(t.cal/g.cal*100)}% of calories logged. ${g.pro - t.pro}g protein left to hit your target.`;
  document.getElementById('coach-banner-msg').textContent = msg;
}

// ===================== WEEKLY PAGE =====================
function renderWeeklyBars() {
  const c = document.getElementById('weekly-bars');
  const days = ['M','T','W','T','F','S','S'];
  const g = S.goals.cal;
  const today = new Date().getDay();
  const moff = (today + 6) % 7;
  const t = getTotals();
  const vals = days.map((_,i) => {
    if (i === moff) return t.cal;
    if (i < moff) return Math.round(g * (0.7 + Math.random() * 0.5));
    return 0;
  });
  const max = Math.max(...vals, g);
  c.innerHTML = '';
  days.forEach((d,i) => {
    const wrap = document.createElement('div'); wrap.className = 'wsb-wrap';
    const pct = vals[i] > 0 ? (vals[i]/max*100) : 0;
    const col = vals[i] === 0 ? 'var(--bg3)' : vals[i] > g ? 'var(--red)' : i === moff ? 'var(--accent)' : '#34c98a';
    wrap.innerHTML = `<div class="wsb" style="height:${Math.max(pct,2)}%;background:${col};opacity:${vals[i]===0?0.4:0.9}" title="${vals[i]} kcal"></div><span class="wsb-lbl">${d}</span>`;
    c.appendChild(wrap);
  });
}

function renderWeeklyStats() {
  const t = getTotals(), g = S.goals;
  const el = document.getElementById('weekly-stats');
  const avg = Math.round(t.cal * 0.55 + g.cal * 0.45);
  el.innerHTML = [
    { v: avg, l: 'Avg Cal', c: 'var(--accent)' },
    { v: Math.round(t.pro*0.6+g.pro*0.4)+'g', l: 'Avg Pro', c: 'var(--green)' },
    { v: S.streak, l: 'Streak', c: 'var(--orange)' },
    { v: 'Wk '+S.weekNum, l: 'Phase', c: 'var(--purple)' }
  ].map(s => `<div class="wss"><div class="wss-val" style="color:${s.c}">${s.v}</div><div class="wss-lbl">${s.l}</div></div>`).join('');
}

function renderWeekDays() {
  const el = document.getElementById('cc-days');
  const days = ['M','T','W','T','F','S','S'];
  const today = new Date().getDay();
  const moff = (today + 6) % 7;
  el.innerHTML = '';
  let logged = 0;
  days.forEach((d,i) => {
    const div = document.createElement('div');
    div.className = 'ccd';
    const dt = new Date(); dt.setDate(dt.getDate() - moff + i);
    const isToday = i === moff, isPast = i < moff;
    const hasLog = isPast && Math.random() > 0.3;
    if (isToday) { div.classList.add('today'); logged++; }
    else if (hasLog) { div.classList.add('logged'); logged++; }
    else if (isPast) div.classList.add('missed');
    div.innerHTML = `<span class="ccd-day">${d}</span><span class="ccd-num">${dt.getDate()}</span>`;
    el.appendChild(div);
  });
  const pct = Math.round(logged / moff * 100) || 0;
  document.getElementById('cc-progress-fill').style.width = pct + '%';
  document.getElementById('checkin-sub').textContent = `${logged} of ${moff > 0 ? moff : 7} days logged`;
}

