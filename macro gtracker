<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Carbon AI — Diet Coach</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #111214;
  --bg2: #18191c;
  --bg3: #1e2023;
  --card: #1e2023;
  --card2: #252629;
  --border: #2c2d31;
  --border2: #363739;
  --accent: #4f9cf9;
  --accent-dim: rgba(79,156,249,0.12);
  --accent-glow: rgba(79,156,249,0.25);
  --green: #34c98a;
  --green-dim: rgba(52,201,138,0.12);
  --orange: #f5a623;
  --orange-dim: rgba(245,166,35,0.12);
  --red: #f25a5a;
  --red-dim: rgba(242,90,90,0.1);
  --purple: #9b7cff;
  --text: #f0f1f3;
  --text2: #8b8d94;
  --text3: #4a4c52;
  --r: 14px;
  --rsm: 10px;
  --rxs: 6px;
  --font: 'Plus Jakarta Sans', sans-serif;
  --nav-h: 72px;
  --max-w: 430px;
}

* { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }

html, body {
  background: #0a0b0c;
  min-height: 100vh;
  font-family: var(--font);
  color: var(--text);
  display: flex;
  justify-content: center;
}

/* PHONE SHELL */
.phone {
  width: 100%;
  max-width: var(--max-w);
  min-height: 100vh;
  background: var(--bg);
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* PAGES */
.page { display: none; flex-direction: column; flex: 1; overflow-y: auto; padding-bottom: calc(var(--nav-h) + 8px); }
.page.active { display: flex; }

/* SCROLLBAR */
.page::-webkit-scrollbar { width: 0; }

/* STATUS BAR */
.status-bar {
  background: var(--bg);
  padding: 12px 20px 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12px;
  font-weight: 600;
  color: var(--text2);
  flex-shrink: 0;
}

/* TOP NAV */
.topnav {
  padding: 10px 20px 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.topnav-title {
  font-size: 17px;
  font-weight: 700;
  color: var(--text);
}

.icon-btn {
  width: 36px; height: 36px;
  border-radius: 50%;
  background: var(--card);
  border: 1px solid var(--border);
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  font-size: 15px;
  transition: all 0.15s;
  flex-shrink: 0;
}
.icon-btn:hover { background: var(--card2); border-color: var(--border2); }

/* DATE NAV */
.date-nav {
  padding: 0 20px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}
.date-arrow { width: 32px; height: 32px; border-radius: 50%; background: var(--card); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--text2); font-size: 13px; transition: all 0.15s; }
.date-arrow:hover { background: var(--card2); color: var(--text); }
.date-label { font-size: 14px; font-weight: 600; color: var(--text); text-align: center; }
.date-sub { font-size: 11px; color: var(--text3); text-align: center; margin-top: 1px; }

/* MACRO RINGS SECTION */
.rings-section {
  padding: 0 20px 20px;
  flex-shrink: 0;
}

.rings-card {
  background: var(--card);
  border-radius: var(--r);
  border: 1px solid var(--border);
  padding: 20px 16px 16px;
}

.cal-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-bottom: 20px;
}

.main-ring-wrap {
  position: relative;
  width: 120px; height: 120px;
  flex-shrink: 0;
}

.main-ring-wrap svg { transform: rotate(-90deg); }

.ring-center {
  position: absolute; inset: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}

.ring-kcal { font-size: 26px; font-weight: 800; color: var(--text); line-height: 1; }
.ring-unit { font-size: 10px; color: var(--text3); text-transform: uppercase; letter-spacing: 1px; margin-top: 2px; }
.ring-goal-txt { font-size: 10px; color: var(--text3); margin-top: 3px; }

.cal-info { flex: 1; }
.cal-stat { margin-bottom: 10px; }
.cal-stat-val { font-size: 20px; font-weight: 700; color: var(--text); }
.cal-stat-lbl { font-size: 10px; color: var(--text3); text-transform: uppercase; letter-spacing: 0.8px; margin-top: 1px; }
.cal-stat.remaining .cal-stat-val { color: var(--green); }
.cal-stat.burned .cal-stat-val { color: var(--orange); }

.macro-rings-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

.macro-ring-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}

.mini-ring-wrap { position: relative; width: 62px; height: 62px; flex-shrink: 0; }
.mini-ring-wrap svg { transform: rotate(-90deg); }
.mini-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.mini-val { font-size: 13px; font-weight: 700; color: var(--text); line-height: 1; }
.mini-unit { font-size: 9px; color: var(--text3); margin-top: 1px; }
.macro-name { font-size: 11px; color: var(--text2); font-weight: 500; }
.macro-remaining { font-size: 10px; color: var(--text3); }

/* MEAL SECTION */
.meals-section { padding: 0 20px; display: flex; flex-direction: column; gap: 10px; }

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4px;
}
.section-title { font-size: 13px; font-weight: 600; color: var(--text2); text-transform: uppercase; letter-spacing: 1px; }

.meal-card {
  background: var(--card);
  border-radius: var(--r);
  border: 1px solid var(--border);
  overflow: hidden;
  transition: border-color 0.15s;
}

.meal-header {
  padding: 14px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  user-select: none;
  transition: background 0.12s;
}
.meal-header:active { background: rgba(255,255,255,0.03); }

.meal-icon {
  width: 38px; height: 38px;
  border-radius: var(--rsm);
  display: flex; align-items: center; justify-content: center;
  font-size: 18px;
  flex-shrink: 0;
}

.meal-info { flex: 1; min-width: 0; }
.meal-name { font-size: 14px; font-weight: 600; color: var(--text); }
.meal-kcal-sub { font-size: 12px; color: var(--text3); margin-top: 1px; }

.meal-right { display: flex; align-items: center; gap: 10px; }
.meal-kcal-badge {
  font-size: 13px; font-weight: 700; color: var(--text2);
}
.meal-add-btn {
  width: 28px; height: 28px;
  border-radius: 50%;
  background: var(--accent-dim);
  border: 1px solid rgba(79,156,249,0.2);
  display: flex; align-items: center; justify-content: center;
  color: var(--accent);
  font-size: 18px;
  cursor: pointer;
  transition: all 0.15s;
  line-height: 1;
  flex-shrink: 0;
}
.meal-add-btn:hover { background: var(--accent-glow); }

.meal-chevron { color: var(--text3); font-size: 11px; transition: transform 0.2s; }
.meal-card.open .meal-chevron { transform: rotate(90deg); }

.meal-items { display: none; border-top: 1px solid var(--border); }
.meal-card.open .meal-items { display: block; }

.food-item {
  padding: 11px 16px;
  display: flex;
  align-items: center;
  gap: 10px;
  border-bottom: 1px solid var(--border);
  transition: background 0.12s;
}
.food-item:last-child { border-bottom: none; }
.food-item:active { background: rgba(255,255,255,0.02); }

.food-color-bar { width: 3px; height: 32px; border-radius: 2px; flex-shrink: 0; }
.food-text { flex: 1; min-width: 0; }
.food-name-txt { font-size: 13px; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 500; }
.food-serving-txt { font-size: 11px; color: var(--text3); margin-top: 2px; }
.food-macros-row { display: flex; gap: 8px; margin-top: 3px; flex-wrap: wrap; }
.fmr { font-size: 10px; color: var(--text3); }
.fmr span { color: var(--text2); }
.food-cal-txt { font-size: 13px; font-weight: 600; color: var(--text2); min-width: 38px; text-align: right; flex-shrink: 0; }
.food-del-btn { background: none; border: none; color: var(--text3); cursor: pointer; font-size: 13px; padding: 4px; opacity: 0.5; transition: opacity 0.12s; }
.food-del-btn:hover { opacity: 1; color: var(--red); }

.meal-empty {
  padding: 14px 16px;
  font-size: 12px;
  color: var(--text3);
  text-align: center;
}

.meal-footer {
  padding: 10px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(255,255,255,0.015);
  border-top: 1px solid var(--border);
}
.meal-footer-macro { text-align: center; }
.mfm-val { font-size: 12px; font-weight: 600; color: var(--text); }
.mfm-lbl { font-size: 9px; color: var(--text3); text-transform: uppercase; letter-spacing: 0.5px; }

/* WATER */
.water-card {
  margin: 10px 20px 0;
  background: var(--card);
  border-radius: var(--r);
  border: 1px solid var(--border);
  padding: 14px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.water-icon { font-size: 22px; flex-shrink: 0; }
.water-info { flex: 1; }
.water-title { font-size: 13px; font-weight: 600; color: var(--text); }
.water-sub { font-size: 11px; color: var(--text3); margin-top: 1px; }
.water-glasses { display: flex; gap: 4px; margin-top: 8px; }
.wg { font-size: 14px; cursor: pointer; transition: all 0.1s; opacity: 0.3; }
.wg.filled { opacity: 1; }
.water-add-btn { background: var(--accent-dim); border: 1px solid rgba(79,156,249,0.2); border-radius: var(--rxs); padding: 6px 12px; color: var(--accent); font-size: 12px; font-weight: 600; cursor: pointer; font-family: var(--font); transition: all 0.15s; }
.water-add-btn:hover { background: var(--accent-glow); }

/* AI COACH BANNER */
.coach-banner {
  margin: 10px 20px 0;
  background: linear-gradient(135deg, #1a1f2e, #151a26);
  border-radius: var(--r);
  border: 1px solid rgba(79,156,249,0.2);
  padding: 14px 16px;
  display: flex;
  gap: 12px;
  align-items: flex-start;
  cursor: pointer;
  transition: border-color 0.15s;
}
.coach-banner:hover { border-color: rgba(79,156,249,0.35); }
.coach-av { width: 36px; height: 36px; border-radius: 50%; background: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
.coach-text { flex: 1; }
.coach-title { font-size: 12px; font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: 0.8px; }
.coach-msg { font-size: 13px; color: var(--text2); line-height: 1.5; margin-top: 3px; }
.coach-caret { color: var(--text3); font-size: 12px; align-self: center; }

/* BOTTOM NAV */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  max-width: var(--max-w);
  height: var(--nav-h);
  background: var(--bg2);
  border-top: 1px solid var(--border);
  display: flex;
  align-items: flex-start;
  padding-top: 8px;
  z-index: 50;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  cursor: pointer;
  padding: 6px 0;
  transition: all 0.15s;
  position: relative;
}

.nav-icon { font-size: 22px; transition: transform 0.15s; }
.nav-label { font-size: 10px; font-weight: 500; color: var(--text3); transition: color 0.15s; }
.nav-item.active .nav-label { color: var(--accent); }
.nav-item.active .nav-icon { transform: scale(1.1); }

.nav-dot {
  position: absolute;
  top: 3px; right: 50%;
  transform: translateX(8px);
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--accent);
  display: none;
}

/* ============ WEEKLY PAGE ============ */
.section-pad { padding: 0 20px; }

.weekly-summary {
  margin: 0 20px 14px;
  background: var(--card);
  border-radius: var(--r);
  border: 1px solid var(--border);
  padding: 16px;
}

.ws-title { font-size: 12px; color: var(--text3); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 12px; }

.ws-bars { display: flex; gap: 5px; align-items: flex-end; height: 80px; margin-bottom: 10px; }
.wsb-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px; height: 100%; justify-content: flex-end; }
.wsb { width: 100%; border-radius: 4px 4px 0 0; min-height: 3px; transition: height 0.4s cubic-bezier(.23,1,.32,1); cursor: pointer; }
.wsb:hover { filter: brightness(1.2); }
.wsb-lbl { font-size: 9px; color: var(--text3); }

.ws-stats { display: grid; grid-template-columns: repeat(4,1fr); gap: 8px; }
.wss { text-align: center; padding: 10px 6px; background: var(--bg3); border-radius: var(--rsm); border: 1px solid var(--border); }
.wss-val { font-size: 15px; font-weight: 700; }
.wss-lbl { font-size: 9px; color: var(--text3); text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px; }

.checkin-card {
  margin: 0 20px 14px;
  background: linear-gradient(135deg, #1f2a1a, #171f13);
  border-radius: var(--r);
  border: 1px solid rgba(52,201,138,0.2);
  padding: 16px;
}
.cc-top { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.cc-icon { font-size: 22px; }
.cc-title { font-size: 14px; font-weight: 700; color: var(--text); }
.cc-sub { font-size: 11px; color: var(--text3); }
.cc-progress { height: 4px; background: var(--bg3); border-radius: 2px; overflow: hidden; margin-bottom: 10px; }
.cc-fill { height: 100%; background: var(--green); border-radius: 2px; }
.cc-days { display: flex; gap: 6px; }
.ccd { flex: 1; aspect-ratio: 1; border-radius: var(--rxs); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px; border: 1px solid var(--border); background: var(--bg3); font-size: 10px; }
.ccd.logged { background: var(--green-dim); border-color: rgba(52,201,138,0.3); }
.ccd.today { background: var(--accent-dim); border-color: rgba(79,156,249,0.3); }
.ccd.missed { background: var(--red-dim); border-color: rgba(242,90,90,0.2); }
.ccd-day { font-size: 8px; color: var(--text3); text-transform: uppercase; }
.ccd-num { font-size: 12px; font-weight: 700; color: var(--text); }
.ccd.today .ccd-num { color: var(--accent); }

/* ============ PROGRESS PAGE ============ */
.prog-header { padding: 0 20px 16px; }
.prog-title { font-size: 22px; font-weight: 800; color: var(--text); margin-bottom: 4px; }
.prog-sub { font-size: 13px; color: var(--text3); }

.prog-card {
  margin: 0 20px 14px;
  background: var(--card);
  border-radius: var(--r);
  border: 1px solid var(--border);
  padding: 16px;
}
.prog-card-title { font-size: 12px; font-weight: 600; color: var(--text3); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 14px; }

.weight-display { display: flex; align-items: baseline; gap: 6px; margin-bottom: 12px; }
.wd-val { font-size: 36px; font-weight: 800; color: var(--text); line-height: 1; }
.wd-unit { font-size: 14px; color: var(--text3); }
.wd-delta { font-size: 13px; font-weight: 600; color: var(--green); }

.fake-chart { height: 80px; position: relative; }
.fake-chart-line { position: absolute; bottom: 0; left: 0; right: 0; }

.weight-input-row { display: flex; gap: 10px; margin-top: 12px; }
.weight-input { flex: 1; background: var(--bg3); border: 1px solid var(--border); border-radius: var(--rsm); padding: 10px 12px; color: var(--text); font-family: var(--font); font-size: 14px; font-weight: 600; outline: none; transition: border-color 0.15s; }
.weight-input:focus { border-color: var(--accent); }
.weight-log-btn { background: var(--accent); border: none; border-radius: var(--rsm); padding: 10px 18px; color: #fff; font-family: var(--font); font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.15s; }
.weight-log-btn:hover { opacity: 0.9; }

.stat-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 0 20px 14px; }
.sg-card { background: var(--card); border-radius: var(--r); border: 1px solid var(--border); padding: 14px; }
.sg-icon { font-size: 20px; margin-bottom: 8px; }
.sg-val { font-size: 22px; font-weight: 700; color: var(--text); }
.sg-unit { font-size: 12px; color: var(--text3); margin-left: 3px; }
.sg-lbl { font-size: 11px; color: var(--text3); margin-top: 3px; }
.sg-delta { font-size: 11px; margin-top: 4px; font-weight: 600; }

/* ============ SETTINGS PAGE ============ */
.settings-group { margin: 0 20px 16px; }
.sg-title { font-size: 11px; color: var(--text3); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; }
.settings-card { background: var(--card); border-radius: var(--r); border: 1px solid var(--border); overflow: hidden; }
.setting-row { padding: 14px 16px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border); cursor: pointer; transition: background 0.12s; }
.setting-row:last-child { border-bottom: none; }
.setting-row:hover { background: var(--card2); }
.sr-left { display: flex; align-items: center; gap: 12px; }
.sr-icon { width: 32px; height: 32px; border-radius: var(--rxs); display: flex; align-items: center; justify-content: center; font-size: 16px; }
.sr-label { font-size: 14px; font-weight: 500; color: var(--text); }
.sr-sub { font-size: 11px; color: var(--text3); margin-top: 1px; }
.sr-right { display: flex; align-items: center; gap: 8px; }
.sr-val { font-size: 13px; color: var(--text3); }
.sr-caret { color: var(--text3); font-size: 11px; }

/* Toggle */
.toggle { width: 44px; height: 26px; background: var(--bg3); border-radius: 13px; border: 1px solid var(--border); position: relative; cursor: pointer; transition: background 0.2s; }
.toggle.on { background: var(--accent); border-color: var(--accent); }
.toggle-knob { position: absolute; top: 2px; left: 2px; width: 20px; height: 20px; border-radius: 50%; background: var(--text2); transition: all 0.2s; }
.toggle.on .toggle-knob { left: 20px; background: #fff; }

/* ============ MODALS ============ */
.modal-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.75);
  backdrop-filter: blur(6px);
  z-index: 200;
  display: none;
  align-items: flex-end;
  justify-content: center;
}
.modal-overlay.open { display: flex; }

.modal-sheet {
  background: var(--bg2);
  border-radius: 24px 24px 0 0;
  border-top: 1px solid var(--border);
  width: 100%;
  max-width: var(--max-w);
  max-height: 92vh;
  overflow-y: auto;
  animation: sheetUp 0.28s cubic-bezier(.23,1,.32,1);
}

.modal-sheet.modal-centered {
  border-radius: 20px;
  margin: 20px;
  max-height: 85vh;
  width: calc(100% - 40px);
  animation: slideUp 0.25s cubic-bezier(.23,1,.32,1);
}

@keyframes sheetUp { from { transform: translateY(60px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@keyframes slideUp { from { transform: translateY(20px); opacity: 0.5; } to { transform: translateY(0); opacity: 1; } }

.sheet-handle { width: 36px; height: 4px; background: var(--border2); border-radius: 2px; margin: 10px auto 0; }
.sheet-header { padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border); }
.sheet-title { font-size: 17px; font-weight: 700; color: var(--text); }
.sheet-close { width: 30px; height: 30px; border-radius: 50%; background: var(--card2); border: none; color: var(--text2); font-size: 14px; cursor: pointer; display: flex; align-items: center; justify-content: center; }
.sheet-body { padding: 16px 20px; }
.sheet-footer { padding: 12px 20px 24px; display: flex; gap: 10px; }

/* FORM */
.fg { margin-bottom: 14px; }
.fl { font-size: 11px; font-weight: 600; color: var(--text3); text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 7px; display: block; }
.fi { width: 100%; background: var(--bg3); border: 1px solid var(--border); border-radius: var(--rsm); padding: 12px 14px; color: var(--text); font-family: var(--font); font-size: 14px; font-weight: 500; outline: none; transition: border-color 0.15s; }
.fi:focus { border-color: var(--accent); }
.fi::placeholder { color: var(--text3); }
.fsel { width: 100%; background: var(--bg3); border: 1px solid var(--border); border-radius: var(--rsm); padding: 12px 14px; color: var(--text); font-family: var(--font); font-size: 14px; outline: none; cursor: pointer; }
.fsel:focus { border-color: var(--accent); }
.fg2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.fg3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; }

.btn-primary { flex: 1; background: var(--accent); border: none; border-radius: var(--rsm); padding: 14px; color: #fff; font-family: var(--font); font-size: 15px; font-weight: 700; cursor: pointer; transition: all 0.15s; }
