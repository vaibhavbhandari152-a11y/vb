}

function switchTab(tab, btn) {
  document.querySelectorAll('.tab-row .tab-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('tab-search').style.display = tab === 'search' ? '' : 'none';
  document.getElementById('tab-manual').style.display = tab === 'manual' ? '' : 'none';
}

function confirmAdd() {
  const isSearch = document.getElementById('tab-search').style.display !== 'none';
  if (isSearch) {
    if (!selectedFood) { showToast('⚠ Select a food first'); return; }
    const amt = parseFloat(document.getElementById('sb-amount').value) || 100;
    const unit = document.getElementById('sb-unit').value;
    const factors = { g:1, oz:28.35, serving:100, cup:240, tbsp:15, tsp:5, piece:100 };
    const grams = amt * (factors[unit] || 1);
    const m = grams / 100;
    S.meals[currentMealType].push({
      name: selectedFood.name,
      srv: `${amt}${unit}${selectedFood.brand ? ' · ' + selectedFood.brand : ''}`,
      cal: Math.round(selectedFood.cal100 * m),
      pro: Math.round(selectedFood.pro100 * m * 10) / 10,
      car: Math.round(selectedFood.car100 * m * 10) / 10,
      fat: Math.round(selectedFood.fat100 * m * 10) / 10
    });
  } else {
    const name = document.getElementById('m-name').value.trim();
    const cal = parseInt(document.getElementById('m-cal').value) || 0;
    if (!name || !cal) { showToast('⚠ Enter food name and calories'); return; }
    S.meals[currentMealType].push({
      name, cal,
      pro: parseFloat(document.getElementById('m-pro').value) || 0,
      car: parseFloat(document.getElementById('m-car').value) || 0,
      fat: parseFloat(document.getElementById('m-fat').value) || 0,
      srv: document.getElementById('m-srv').value.trim()
    });
  }
  closeModal('add-modal');
  renderMealCards(); updateRings();
  showToast('✓ Added to ' + MC[currentMealType].l);
