.search-spinner { position: absolute; right: 12px; top: 50%; width: 16px; height: 16px; border: 2px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.7s linear infinite; display: none; transform: translateY(-50%); }
@keyframes spin { to { transform: translateY(-50%) rotate(360deg); } }

.search-hint { font-size: 12px; color: var(--text3); text-align: center; padding: 16px; }

.search-results { max-height: 260px; overflow-y: auto; }
.sr-item { padding: 12px 0; border-bottom: 1px solid var(--border); cursor: pointer; transition: background 0.12s; border-radius: var(--rxs); padding: 11px 10px; }
