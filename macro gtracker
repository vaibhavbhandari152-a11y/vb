<script>
// ===================== STATE =====================
let S = JSON.parse(localStorage.getItem('carbon_ai') || 'null') || {
  goals: { cal: 2000, pro: 150, car: 200, fat: 65, water: 8 },
  goalType: 'cut',
  dietPref: 'balanced',
  meals: { breakfast: [], lunch: [], dinner: [], snack: [] },
  water: 0,
  streak: 3,
  weekNum: 1,
  weightLog: [],
  checkinCompliance: null
};

const MC = {
  breakfast: { l: 'Breakfast', e: '🌅', c: '#f5a623', bg: 'rgba(245,166,35,0.1)' },
  lunch:     { l: 'Lunch',     e: '☀️', c: '#34c98a', bg: 'rgba(52,201,138,0.1)' },
  dinner:    { l: 'Dinner',    e: '🌙', c: '#4f9cf9', bg: 'rgba(79,156,249,0.1)' },
  snack:     { l: 'Snacks',    e: '🍎', c: '#9b7cff', bg: 'rgba(155,124,255,0.1)' }
};

let selectedFood = null;
let scannedData = null;
let currentMealType = 'breakfast';
let chatHistory = [];
let searchTimer = null;
let checkinChoice = null;
let dayOffset = 0;

// ===================== INIT =====================
function init() {
  updateStatusTime();
  setInterval(updateStatusTime, 30000);
  renderDiaryDate();
  renderMealCards();
  updateRings();
  renderWater();
  renderWeekDays();
  renderWeeklyBars();
  renderWeeklyStats();
  updateCoachBanner();
  updateProgressPage();
  updateSettingsPage();
}

function updateStatusTime() {
  const t = new Date();
  const s = t.getHours()+':'+(t.getMinutes()<10?'0':'')+t.getMinutes();
  document.querySelectorAll('[id^=status-time]').forEach(el => el.textContent = s);
}

// ===================== DATE =====================
function renderDiaryDate() {
  const d = new Date();
  d.setDate(d.getDate() + dayOffset);
  const labels = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  document.getElementById('diary-date-label').textContent = dayOffset === 0 ? 'Today' : dayOffset === -1 ? 'Yesterday' : `${labels[d.getDay()]} ${months[d.getMonth()]} ${d.getDate()}`;
  document.getElementById('diary-date-sub').textContent = `${labels[d.getDay()]}, ${months[d.getMonth()]} ${d.getDate()}`;
}

function changeDay(n) {
  if (dayOffset + n > 0) return;
  dayOffset += n;
  renderDiaryDate();
}

// ===================== RINGS =====================
function getTotals() {
  let cal=0,pro=0,car=0,fat=0,count=0;
  Object.values(S.meals).forEach(m => m.forEach(i => { cal+=i.cal; pro+=i.pro; car+=i.car; fat+=i.fat; count++; }));
  return { cal, pro, car, fat, count };
}

function updateRings() {
  const t = getTotals(), g = S.goals;
  document.getElementById('r-cal').textContent = t.cal;
  document.getElementById('r-goal-txt').textContent = 'of ' + g.cal;
  document.getElementById('r-goal-num').textContent = g.cal;
  document.getElementById('r-rem').textContent = Math.max(0, g.cal - t.cal);

  const setRing = (id, val, goal, circ) => {
    const pct = Math.min(1, val / goal);
    document.getElementById(id).style.strokeDashoffset = circ - circ * pct;
  };
  setRing('cal-ring', t.cal, g.cal, 327);
  setRing('p-ring', t.pro, g.pro, 157);
  setRing('c-ring', t.car, g.car, 157);
  setRing('f-ring', t.fat, g.fat, 157);

  document.getElementById('mr-pro').textContent = t.pro;
  document.getElementById('mr-car').textContent = t.car;
  document.getElementById('mr-fat').textContent = t.fat;
  document.getElementById('mr-pro-rem').textContent = Math.max(0, g.pro - t.pro) + 'g left';
  document.getElementById('mr-car-rem').textContent = Math.max(0, g.car - t.car) + 'g left';
  document.getElementById('mr-fat-rem').textContent = Math.max(0, g.fat - t.fat) + 'g left';

  updateProgressPage();
  updateCoachBanner();
  save();
}

// ===================== MEAL CARDS =====================
function renderMealCards() {
  const c = document.getElementById('meal-cards-container');
  c.innerHTML = '';
  Object.entries(MC).forEach(([type, cfg]) => {
    const items = S.meals[type];
    const mCal = items.reduce((s,i) => s+i.cal, 0);
    const mPro = items.reduce((s,i) => s+i.pro, 0);
    const mCar = items.reduce((s,i) => s+i.car, 0);
    const mFat = items.reduce((s,i) => s+i.fat, 0);

    const card = document.createElement('div');
    card.className = 'meal-card' + (items.length > 0 ? ' open' : '');
    card.innerHTML = `
      <div class="meal-header" onclick="toggleCard(this.parentElement)">
        <div class="meal-icon" style="background:${cfg.bg}">${cfg.e}</div>
        <div class="meal-info">
          <div class="meal-name">${cfg.l}</div>
          <div class="meal-kcal-sub">${items.length > 0 ? items.length + ' item' + (items.length > 1 ? 's' : '') : 'Tap + to add food'}</div>
        </div>
        <div class="meal-right">
          <div class="meal-kcal-badge">${mCal > 0 ? mCal + ' cal' : ''}</div>
          <div class="meal-add-btn" onclick="event.stopPropagation();openAdd('${type}')">+</div>
          <div class="meal-chevron">›</div>
        </div>
      </div>
      <div class="meal-items">
        ${items.length === 0
          ? `<div class="meal-empty">No ${cfg.l.toLowerCase()} logged yet</div>`
          : items.map((item, idx) => `
            <div class="food-item">
              <div class="food-color-bar" style="background:${cfg.c}"></div>
              <div class="food-text">
                <div class="food-name-txt">${item.name}</div>
                <div class="food-serving-txt">${item.srv || ''}</div>
                <div class="food-macros-row">
                  <span class="fmr">P: <span>${item.pro}g</span></span>
                  <span class="fmr">C: <span>${item.car}g</span></span>
                  <span class="fmr">F: <span>${item.fat}g</span></span>
                </div>
              </div>
              <div class="food-cal-txt">${item.cal}</div>
              <button class="food-del-btn" onclick="delFood('${type}',${idx})">✕</button>
            </div>`).join('')
        }
        ${items.length > 0 ? `
          <div class="meal-footer">
            <div class="meal-footer-macro"><div class="mfm-val">${mCal}</div><div class="mfm-lbl">kcal</div></div>
            <div class="meal-footer-macro"><div class="mfm-val" style="color:var(--green)">${mPro}g</div><div class="mfm-lbl">protein</div></div>
            <div class="meal-footer-macro"><div class="mfm-val" style="color:var(--orange)">${mCar}g</div><div class="mfm-lbl">carbs</div></div>
            <div class="meal-footer-macro"><div class="mfm-val" style="color:var(--purple)">${mFat}g</div><div class="mfm-lbl">fat</div></div>
          </div>` : ''}
      </div>`;
    c.appendChild(card);
  });
}

function toggleCard(card) { card.classList.toggle('open'); }

function delFood(type, idx) {
  const name = S.meals[type][idx].name;
  S.meals[type].splice(idx, 1);
  renderMealCards(); updateRings();
  showToast('✕ ' + name + ' removed');
}

// ===================== WATER =====================
function renderWater() {
  const w = S.water, goal = S.goals.water;
  document.getElementById('water-count').textContent = w;
  document.getElementById('water-goal-txt').textContent = goal;
  const el = document.getElementById('water-glasses');
  el.innerHTML = Array.from({length: Math.min(goal, 10)}, (_,i) =>
    `<span class="wg ${i < w ? 'filled' : ''}" onclick="setWater(${i+1})">💧</span>`
  ).join('');
}

function addWater() { S.water = Math.min(S.goals.water + 2, S.water + 1); renderWater(); save(); showToast('💧 Water updated'); }
function setWater(n) { S.water = n; renderWater(); save(); }

// ===================== FOOD SEARCH =====================
function debounce(val) {
  clearTimeout(searchTimer);
  const hint = document.getElementById('s-hint');
  const results = document.getElementById('s-results');
  if (val.length < 2) {
    hint.style.display = '';
    results.innerHTML = '';
    document.getElementById('serving-section').style.display = 'none';
    selectedFood = null;
    return;
  }
  hint.style.display = 'none';
  document.getElementById('s-spinner').style.display = 'block';
  searchTimer = setTimeout(() => doSearch(val), 450);
}

async function doSearch(q) {
  const spinner = document.getElementById('s-spinner');
  const results = document.getElementById('s-results');
  try {
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        messages: [{
          role: 'user',
          content: `Nutrition database lookup: "${q}". Return ONLY valid JSON, no markdown:
{"foods":[{"name":"Food Name","brand":"Generic or Brand","cal100":165,"pro100":31,"car100":0,"fat100":3.6,"typical_serving":"100g"}]}`
        }]
      })
    });
    const data = await res.json();
    spinner.style.display = 'none';
    const text = data.content?.[0]?.text || '{}';
    const parsed = JSON.parse(text.replace(/```json|```/g,'').trim());
    const foods = parsed.foods || [];
    if (!foods.length) { results.innerHTML = '<div class="search-hint">No results. Try manual entry.</div>'; return; }
    results.innerHTML = foods.slice(0,8).map((f,i) => `
      <div class="sr-item" onclick="selectFood(${i},'${esc(f.name)}','${esc(f.brand||'')}',${f.cal100},${f.pro100},${f.car100},${f.fat100},'${esc(f.typical_serving||'')}')">
        <div class="sr-item-name">${f.name}</div>
        ${f.brand ? `<div class="sr-item-brand">${f.brand}</div>` : ''}
        <div class="sr-item-macros">
          <span class="sr-chip kcal">${f.cal100} kcal</span>
          <span class="sr-chip pro">P ${f.pro100}g</span>
          <span class="sr-chip car">C ${f.car100}g</span>
          <span class="sr-chip fat">F ${f.fat100}g</span>
          <span class="sr-chip per">per 100g</span>
        </div>
      </div>`).join('');
  } catch(e) {
    spinner.style.display = 'none';
    results.innerHTML = '<div class="search-hint">Search failed. Try manual entry.</div>';
  }
}

function esc(s) { return String(s).replace(/'/g,"\\'").replace(/\n/g,' '); }

function selectFood(i, name, brand, cal100, pro100, car100, fat100, srv) {
  document.querySelectorAll('.sr-item').forEach((el,j) => el.classList.toggle('sel', j===i));
  selectedFood = { name, brand, cal100, pro100, car100, fat100, srv };
  document.getElementById('sb-name').textContent = name + (brand ? ' · ' + brand : '');
  document.getElementById('sb-amount').value = 100;
  document.getElementById('sb-unit').value = 'g';
  document.getElementById('serving-section').style.display = '';
  updatePreview();
  document.getElementById('s-results').innerHTML = '';
}

function updatePreview() {
  if (!selectedFood) return;
  const amt = parseFloat(document.getElementById('sb-amount').value) || 100;
  const unit = document.getElementById('sb-unit').value;
  const factors = { g:1, oz:28.35, serving:100, cup:240, tbsp:15, tsp:5, piece:100 };
  const g = amt * (factors[unit] || 1);
  const m = g / 100;
  document.getElementById('sbp-cal').textContent = Math.round(selectedFood.cal100 * m);
  document.getElementById('sbp-pro').textContent = Math.round(selectedFood.pro100 * m * 10) / 10 + 'g';
  document.getElementById('sbp-car').textContent = Math.round(selectedFood.car100 * m * 10) / 10 + 'g';
  document.getElementById('sbp-fat').textContent = Math.round(selectedFood.fat100 * m * 10) / 10 + 'g';
}

function openAdd(mealType) {
  currentMealType = mealType;
  document.getElementById('add-modal-title').textContent = 'Add to ' + MC[mealType].l;
  document.getElementById('food-search').value = '';
  document.getElementById('s-results').innerHTML = '';
  document.getElementById('s-hint').style.display = '';
  document.getElementById('serving-section').style.display = 'none';
  selectedFood = null;
  // reset manual
  ['m-name','m-cal','m-pro','m-car','m-fat','m-srv'].forEach(id => document.getElementById(id).value = '');
  document.getElementById('add-modal').classList.add('open');
