/* SEARCH */
.search-wrap { position: relative; margin-bottom: 12px; }
.search-input { width: 100%; background: var(--bg3); border: 1px solid var(--border); border-radius: var(--rsm); padding: 12px 14px 12px 38px; color: var(--text); font-family: var(--font); font-size: 14px; outline: none; transition: border-color 0.15s; }
