function updateProgressPage() {
  const t = getTotals(), g = S.goals;
  if (S.weightLog.length) {
    document.getElementById('weight-display').textContent = S.weightLog[S.weightLog.length-1].w;
    if (S.weightLog.length > 1) {
      const delta = S.weightLog[S.weightLog.length-1].w - S.weightLog[0].w;
      document.getElementById('weight-delta').textContent = (delta > 0 ? '+' : '') + delta.toFixed(1) + ' lbs';
      document.getElementById('weight-delta').style.color = S.goalType==='bulk' ? (delta>0?'var(--green)':'var(--red)') : (delta<0?'var(--green)':'var(--red)');
    }
    renderWeightChart();
  }
  document.getElementById('prog-streak').textContent = S.streak;
  document.getElementById('prog-weeknum').textContent = S.weekNum;
  const phases = ['Base Build','Lean Gains','Metabolic Reset','Strength','Recomp'];
  document.getElementById('prog-phase').textContent = phases[(S.weekNum-1)%phases.length];
  const goalLabels = { cut:'Cut', maintain:'Maintain', bulk:'Bulk', recomp:'Recomp' };
  document.getElementById('prog-goal-type').textContent = goalLabels[S.goalType] || S.goalType;
  const goalSubs = { cut:'Fat Loss', maintain:'Maintenance', bulk:'Muscle Gain', recomp:'Recomposition' };
  document.getElementById('prog-goal-sub').textContent = goalSubs[S.goalType] || '';

  const score = calcScore(t.cal, t.pro, t.car, t.fat);
  document.getElementById('prog-score').textContent = score;
  const sl = document.getElementById('prog-score-lbl');
  if (score === '--') { sl.textContent = 'Log to score'; sl.style.color = 'var(--text3)'; }
  else if (score >= 80) { sl.textContent = '⭐ Excellent'; sl.style.color = 'var(--green)'; }
  else if (score >= 60) { sl.textContent = '👍 Good'; sl.style.color = 'var(--accent)'; }
  else { sl.textContent = 'Keep going'; sl.style.color = 'var(--orange)'; }
}

function calcScore(cal, pro, car, fat) {
  const g = S.goals;
  if (cal === 0) return '--';
  let s = 0;
  s += Math.min(30, 30 * Math.min(pro, g.pro) / g.pro);
  s += Math.min(30, 30 * (1 - Math.abs(cal - g.cal) / g.cal));
  s += Math.min(20, 20 * Math.min(car, g.car) / g.car);
  s += Math.min(20, 20 * Math.min(fat, g.fat) / g.fat);
  return Math.round(s);
}

function logWeight() {
  const val = parseFloat(document.getElementById('weight-input').value);
  if (!val || val < 50 || val > 500) { showToast('⚠ Enter a valid weight'); return; }
  S.weightLog.push({ w: val, d: new Date().toISOString() });
  document.getElementById('weight-input').value = '';
  updateProgressPage();
  save();
  showToast('✓ Weight logged: ' + val + ' lbs');
}

function renderWeightChart() {
  if (S.weightLog.length < 2) return;
  const logs = S.weightLog.slice(-10);
  const vals = logs.map(l => l.w);
  const min = Math.min(...vals) - 2, max = Math.max(...vals) + 2;
  const W = 300, H = 70;
  const pts = vals.map((v,i) => {
    const x = (i / (vals.length-1)) * W;
    const y = H - ((v - min) / (max - min)) * H;
    return `${x},${y}`;
  });
  const linePts = pts.join(' ');
  const areaPts = `0,${H} ${linePts} ${W},${H}`;
  document.getElementById('weight-chart-line').setAttribute('points', linePts);
  document.getElementById('weight-chart-area').setAttribute('points', areaPts);
}

// ===================== NAVIGATION =====================
function setPage(name, navEl) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById('page-' + name).classList.add('active');
  if (navEl) navEl.classList.add('active');
  if (name === 'weekly') { renderWeeklyBars(); renderWeeklyStats(); renderWeekDays(); }
}

// ===================== UTILS =====================
function closeModal(id) { document.getElementById(id).classList.remove('open'); }

function save() { try { localStorage.setItem('carbon_ai', JSON.stringify(S)); } catch(e) {} }

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  clearTimeout(t._timer);
  t._timer = setTimeout(() => t.classList.remove('show'), 2500);
}

document.querySelectorAll('.modal-overlay').forEach(o => {
  o.addEventListener('click', e => { if (e.target === o) o.classList.remove('open'); });
});

init();
</script>
