.arc-label { font-size: 12px; color: var(--text2); }
.arc-change { font-size: 12px; font-weight: 700; }
.arc-change.up { color: var(--green); }
.arc-change.down { color: var(--red); }
.arc-change.same { color: var(--text3); }

/* TOAST */
.toast { position: fixed; top: 20px; left: 50%; transform: translateX(-50%) translateY(-80px); background: var(--card); border: 1px solid var(--border); border-radius: 24px; padding: 10px 18px; font-size: 13px; font-weight: 600; color: var(--text); z-index: 999; transition: all 0.3s cubic-bezier(.23,1,.32,1); white-space: nowrap; display: flex; align-items: center; gap: 8px; box-shadow: 0 8px 32px rgba(0,0,0,0.4); }
.toast.show { transform: translateX(-50%) translateY(0); }
</style>
</head>
